import subprocess
from typing import Any

class Error(Exception):
    stdout: bytes
    stderr: bytes
    def __init__(self, cmd: str, stdout: bytes, stderr: bytes) -> None: ...

class Stream:
    node: Any
    label: str | None
    selector: str | None

    def __init__(
        self,
        upstream_node: Any,
        upstream_label: str | None,
        node_types: Any,
        upstream_selector: str | None = ...,
    ) -> None: ...
    def __getitem__(self, index: str) -> Stream: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    @property
    def audio(self) -> Stream: ...
    @property
    def video(self) -> Stream: ...

    # -- output / global-args / execution operators --
    def output(self, *streams_and_filename: Stream | str, **kwargs: Any) -> Stream: ...
    def global_args(self, *args: str) -> Stream: ...
    def overwrite_output(self) -> Stream: ...
    def merge_outputs(self, *streams: Stream) -> Stream: ...
    def compile(self, cmd: str | list[str] = ..., overwrite_output: bool = ...) -> list[str]: ...
    def get_args(self, overwrite_output: bool = ...) -> list[str]: ...
    def run(
        self,
        cmd: str | list[str] = ...,
        capture_stdout: bool = ...,
        capture_stderr: bool = ...,
        input: bytes | None = ...,
        quiet: bool = ...,
        overwrite_output: bool = ...,
    ) -> tuple[bytes, bytes]: ...
    def run_async(
        self,
        cmd: str | list[str] = ...,
        pipe_stdin: bool = ...,
        pipe_stdout: bool = ...,
        pipe_stderr: bool = ...,
        quiet: bool = ...,
        overwrite_output: bool = ...,
    ) -> subprocess.Popen[bytes]: ...
    def view(self, detail: bool = ..., filename: str | None = ..., pipe: bool = ..., **kwargs: Any) -> Any: ...

    # -- filters --
    def filter(self, filter_name: str, *args: Any, **kwargs: Any) -> Stream: ...
    def filter_(self, filter_name: str, *args: Any, **kwargs: Any) -> Stream: ...
    def filter_multi_output(self, filter_name: str, *args: Any, **kwargs: Any) -> Stream: ...
    def split(self) -> Stream: ...
    def asplit(self) -> Stream: ...
    def setpts(self, expr: str) -> Stream: ...
    def trim(self, **kwargs: Any) -> Stream: ...
    def overlay(self, overlay_parent_node: Stream, eof_action: str = ..., **kwargs: Any) -> Stream: ...
    def hflip(self) -> Stream: ...
    def vflip(self) -> Stream: ...
    def crop(self, x: Any, y: Any, width: Any, height: Any, **kwargs: Any) -> Stream: ...
    def drawbox(
        self, x: Any, y: Any, width: Any, height: Any, color: str, thickness: Any = ..., **kwargs: Any
    ) -> Stream: ...
    def drawtext(
        self, text: str | None = ..., x: Any = ..., y: Any = ..., escape_text: bool = ..., **kwargs: Any
    ) -> Stream: ...
    def concat(self, *streams: Stream, **kwargs: Any) -> Stream: ...
    def zoompan(self, **kwargs: Any) -> Stream: ...
    def hue(self, **kwargs: Any) -> Stream: ...
    def colorchannelmixer(self, *args: Any, **kwargs: Any) -> Stream: ...

    # ffmpeg-python attaches many more filters as methods dynamically at import
    # time (see ffmpeg/_filters.py's `@filter_operator()` decorator); fall back
    # to Any for anything not explicitly modeled above.
    def __getattr__(self, name: str) -> Any: ...

def input(filename: str, **kwargs: Any) -> Stream: ...
def output(*streams_and_filename: Stream | str, **kwargs: Any) -> Stream: ...
def merge_outputs(*streams: Stream) -> Stream: ...
def overwrite_output(stream: Stream) -> Stream: ...
def global_args(stream: Stream, *args: str) -> Stream: ...
def compile(stream_spec: Any, cmd: str | list[str] = ..., overwrite_output: bool = ...) -> list[str]: ...
def get_args(stream_spec: Any, overwrite_output: bool = ...) -> list[str]: ...
def run(
    stream_spec: Any,
    cmd: str | list[str] = ...,
    capture_stdout: bool = ...,
    capture_stderr: bool = ...,
    input: bytes | None = ...,
    quiet: bool = ...,
    overwrite_output: bool = ...,
) -> tuple[bytes, bytes]: ...
def run_async(
    stream_spec: Any,
    cmd: str | list[str] = ...,
    pipe_stdin: bool = ...,
    pipe_stdout: bool = ...,
    pipe_stderr: bool = ...,
    quiet: bool = ...,
    overwrite_output: bool = ...,
) -> subprocess.Popen[bytes]: ...
def probe(filename: str, cmd: str = ..., **kwargs: Any) -> dict[str, Any]: ...
def filter(stream_spec: Any, filter_name: str, *args: Any, **kwargs: Any) -> Stream: ...
def filter_(stream_spec: Any, filter_name: str, *args: Any, **kwargs: Any) -> Stream: ...
def filter_multi_output(stream_spec: Any, filter_name: str, *args: Any, **kwargs: Any) -> Stream: ...
def split(stream: Stream) -> Stream: ...
def asplit(stream: Stream) -> Stream: ...
def setpts(stream: Stream, expr: str) -> Stream: ...
def trim(stream: Stream, **kwargs: Any) -> Stream: ...
def overlay(main_parent_node: Stream, overlay_parent_node: Stream, eof_action: str = ..., **kwargs: Any) -> Stream: ...
def hflip(stream: Stream) -> Stream: ...
def vflip(stream: Stream) -> Stream: ...
def crop(stream: Stream, x: Any, y: Any, width: Any, height: Any, **kwargs: Any) -> Stream: ...
def drawbox(
    stream: Stream, x: Any, y: Any, width: Any, height: Any, color: str, thickness: Any = ..., **kwargs: Any
) -> Stream: ...
def drawtext(
    stream: Stream, text: str | None = ..., x: Any = ..., y: Any = ..., escape_text: bool = ..., **kwargs: Any
) -> Stream: ...
def concat(*streams: Stream, **kwargs: Any) -> Stream: ...
def zoompan(stream: Stream, **kwargs: Any) -> Stream: ...
def hue(stream: Stream, **kwargs: Any) -> Stream: ...
def colorchannelmixer(stream: Stream, *args: Any, **kwargs: Any) -> Stream: ...
